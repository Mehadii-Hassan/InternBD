# Supabase (required for Phase 2+)
# Get these from: supabase.com/dashboard > [your project] > Settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin access (required for Phase 4)
# Set a secure password for the /admin dashboard
ADMIN_PASSWORD=your_secure_admin_password

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Featured post boost price (BDT)
FEATURED_BOOST_PRICE=500

# Ads (enable when you have an AdSense publisher ID)
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-your-publisher-id